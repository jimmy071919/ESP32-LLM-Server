# 複製為 .env（權限 600，不提交 Git）後填入實際值。docker compose -f docker-compose_all.yml 會自動讀取。

# MySQL root 密碼。既有部署：先填「目前正在使用的密碼」讓服務能啟動，再依 docs/migration/runbook.md 輪替。
MYSQL_ROOT_PASSWORD=

# （建議）manager-api 使用的最小權限帳號；留空則沿用 root。建立方式見 runbook。
MYSQL_APP_USER=
MYSQL_APP_PASSWORD=

# 8000/8003 綁定位址。預設 127.0.0.1（只經由 8002 反向代理）；裝置直連 :8000 時改 0.0.0.0 或區網 IP。
XIAOZHI_BIND_ADDR=127.0.0.1

# Codex OAuth 憑證加密金鑰（base64 編碼的 32 bytes），例如：openssl rand -base64 32
CODEX_OAUTH_ENCRYPTION_KEY=
